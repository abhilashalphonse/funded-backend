# ACG Funded backend — production environment
NODE_ENV=production
PORT=3000

# Data stores
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/acg_funded?retryWrites=true&w=majority
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/acg_funded?sslmode=require

# Public origins / redirects
CORS_ORIGINS=https://YOUR_FUNDED_FRONTEND_DOMAIN
FRONTEND_URL=https://YOUR_FUNDED_FRONTEND_DOMAIN

# Trading provider: production must use ACG Trader
TRADING_PROVIDER=acg-trader
ACG_TRADER_BASE_URL=https://YOUR_TRADER_BACKEND_DOMAIN
ACG_TRADER_FRONTEND_URL=https://YOUR_TRADER_FRONTEND_DOMAIN
ACG_TRADER_CLIENT_ID=acg-funded-production
ACG_TRADER_API_KEY=REPLACE_WITH_SCOPED_SERVICE_API_KEY
ACG_TRADER_TIMEOUT_MS=10000

# ACG Trader -> ACG Funded signed event webhook
# Must match ACG_TRADER backend ACG_FUNDED_WEBHOOK_SECRET.
ACG_TRADER_WEBHOOK_SECRET=REPLACE_WITH_SHARED_RANDOM_SECRET_MIN_32_CHARS

# NOWPayments
NOWPAYMENTS_API_KEY=REPLACE_WITH_PRODUCTION_API_KEY
NOWPAYMENTS_IPN_SECRET=REPLACE_WITH_PRODUCTION_IPN_SECRET
NOWPAYMENTS_IPN_URL=https://YOUR_FUNDED_BACKEND_DOMAIN/api/payments/crypto/ipn

# Production safety: keep both false.
ENABLE_SIMULATOR_ROUTES=false
ENABLE_LOCAL_ADMIN_ROUTES=false

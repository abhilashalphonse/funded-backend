# ACG FUNDED BACKEND — RAILWAY PRODUCTION TEMPLATE
# Add these in Railway -> Service -> Variables.
# Do not put real production values in this file.

NODE_ENV=production

MONGODB_URI=YOUR_PRODUCTION_MONGODB_URI
POSTGRES_URL=YOUR_PRODUCTION_POSTGRES_URL
POSTGRES_POOL_MAX=4
POSTGRES_CONNECTION_TIMEOUT_MS=30000

# Replace with the Firebase Hosting production origin.
CORS_ORIGINS=https://acg-funded.web.app,https://acg-funded.firebaseapp.com
FRONTEND_URL=https://acg-funded.web.app

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

TRADING_PROVIDER=acg-trader
ACG_TRADER_BASE_URL=https://YOUR_ACG_TRADER_BACKEND_DOMAIN
ACG_TRADER_FRONTEND_URL=https://YOUR_ACG_TRADER_FRONTEND_DOMAIN
ACG_TRADER_CLIENT_ID=acg-funded-backend
ACG_TRADER_API_KEY=YOUR_ACG_TRADER_API_KEY
ACG_TRADER_TIMEOUT_MS=10000
ACG_TRADER_WEBHOOK_SECRET=YOUR_RANDOM_WEBHOOK_SECRET_AT_LEAST_16_CHARS

NOWPAYMENTS_API_KEY=YOUR_NOWPAYMENTS_API_KEY
NOWPAYMENTS_IPN_SECRET=YOUR_NOWPAYMENTS_IPN_SECRET
# Replace YOUR_RAILWAY_DOMAIN after Railway generates the public domain.
NOWPAYMENTS_IPN_URL=https://YOUR_RAILWAY_DOMAIN/api/payments/crypto/ipn

ENABLE_SIMULATOR_ROUTES=false
ENABLE_LOCAL_ADMIN_ROUTES=false

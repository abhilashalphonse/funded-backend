# ACG FUNDED BACKEND — RAILWAY PRODUCTION TEMPLATE
# Add these in Railway -> Service -> Variables.
# Do not put real production values in this file.

NODE_ENV=production
# Use api on the public Railway service and worker on a second background
# service from this same repository. Keep all only during rollout if needed.
ACG_RUNTIME_ROLE=all

MONGODB_URI=YOUR_PRODUCTION_MONGODB_URI
POSTGRES_URL=YOUR_PRODUCTION_POSTGRES_URL
POSTGRES_POOL_MAX=4
POSTGRES_CONNECTION_TIMEOUT_MS=30000

# pg-boss retention. Supervisor remains disabled; ACG runs its own low-contention
# cleanup with short lock/statement timeouts and small batches.
PG_BOSS_RETENTION_ENABLED=true
PG_BOSS_RETENTION_INTERVAL_MS=21600000
PG_BOSS_RETENTION_INITIAL_DELAY_MS=300000
PG_BOSS_RETENTION_BATCH_SIZE=500
PG_BOSS_RETENTION_MAX_BATCHES=5
PG_BOSS_RETENTION_LOCK_TIMEOUT_MS=1000
PG_BOSS_RETENTION_STATEMENT_TIMEOUT_MS=5000

# Upstash Redis hot state
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN
ACG_SNAPSHOT_REDIS_TIMEOUT_MS=1500
ACG_SNAPSHOT_CACHE_TTL_SECONDS=900
ACG_SNAPSHOT_BINDING_TTL_SECONDS=3600
ACG_SNAPSHOT_PROJECTION_CONCURRENCY=32
ACG_SNAPSHOT_PROJECTION_LOCK_MS=10000

# Replace with the Firebase Hosting production origin.
CORS_ORIGINS=https://acg-funded.web.app,https://acg-funded.firebaseapp.com
FRONTEND_URL=https://acg-funded.web.app

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# AI Support
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_SUPPORT_MODEL=gpt-5.6-luna
OPENAI_SUPPORT_TIMEOUT_MS=12000

# Resend inbound + transactional support email
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_WEBHOOK_SECRET=YOUR_RESEND_WEBHOOK_SIGNING_SECRET
SUPPORT_EMAIL_FROM=ACG Funded Support <support@acgfunded.com>
# Optional private/operator mailbox for escalated-case notifications.
SUPPORT_HUMAN_EMAIL=
TRADING_EMAIL_FROM=ACG Trader <trading@acgfunded.com>

TRADING_PROVIDER=acg-trader
ACG_TRADER_BASE_URL=https://YOUR_ACG_TRADER_BACKEND_DOMAIN
ACG_TRADER_FRONTEND_URL=https://YOUR_ACG_TRADER_FRONTEND_DOMAIN
ACG_TRADER_CLIENT_ID=acg-funded-backend
ACG_TRADER_API_KEY=YOUR_ACG_TRADER_API_KEY
ACG_TRADER_TIMEOUT_MS=10000
ACG_TRADER_WEBHOOK_SECRET=YOUR_RANDOM_WEBHOOK_SECRET_AT_LEAST_16_CHARS

NOWPAYMENTS_API_KEY=YOUR_NOWPAYMENTS_API_KEY
NOWPAYMENTS_IPN_SECRET=YOUR_NOWPAYMENTS_IPN_SECRET
# Replace YOUR_RAILWAY_DOMAIN after Railway generates the public domain.
NOWPAYMENTS_IPN_URL=https://YOUR_RAILWAY_DOMAIN/api/payments/crypto/ipn

# Rupayex UPI
RUPAYEX_API_TOKEN=YOUR_RUPAYEX_API_TOKEN
# INR conversion uses cached daily USD/EUR and USD/INR market quotes from Frankfurter.
RUPAYEX_CALLBACK_URL=https://YOUR_RAILWAY_DOMAIN/api/payments/upi/rupayex/callback

ENABLE_SIMULATOR_ROUTES=false
ENABLE_LOCAL_ADMIN_ROUTES=false

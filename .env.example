# =========================================================
# ACG FUNDED BACKEND — ENVIRONMENT TEMPLATE
# =========================================================
# Copy to .env for local development or enter these values
# as Railway service Variables for production.
# Never commit real passwords, API keys, or webhook secrets.

# Application
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/acg_funded

# PostgreSQL / Supabase
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
POSTGRES_POOL_MAX=4
POSTGRES_CONNECTION_TIMEOUT_MS=30000

# Frontend
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Supabase Authentication
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Browser-safe publishable / legacy anon key only.
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Admin access\n# Comma-separated Supabase account emails allowed to access /admin.\nADMIN_EMAILS=admin@example.com\n\n# AI Support
OPENAI_API_KEY=
OPENAI_SUPPORT_MODEL=gpt-5.6-luna
OPENAI_SUPPORT_TIMEOUT_MS=12000

# Trading Provider
TRADING_PROVIDER=acg-trader

# ACG Funded -> ACG Trader
ACG_TRADER_BASE_URL=http://localhost:4000
ACG_TRADER_FRONTEND_URL=http://localhost:5174
ACG_TRADER_CLIENT_ID=acg-funded-backend
ACG_TRADER_TENANT=acg-funded
ACG_TRADER_API_KEY=YOUR_ACG_TRADER_API_KEY
ACG_TRADER_TIMEOUT_MS=10000

# ACG Trader -> ACG Funded Webhooks
ACG_TRADER_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-16-characters

# Trading credentials / transactional email
# Generate a 32-byte key, for example: openssl rand -hex 32
TRADING_CREDENTIAL_ENCRYPTION_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SUPPORT_EMAIL_FROM=ACG Funded Support <support@acgfunded.com>
# Optional private/operator mailbox notified when a case needs a person.
SUPPORT_HUMAN_EMAIL=
TRADING_EMAIL_FROM=ACG Funded <trading@example.com>

# NOWPayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_URL=http://localhost:3000/api/payments/crypto/ipn

# Local-only features
ENABLE_SIMULATOR_ROUTES=true
ENABLE_LOCAL_ADMIN_ROUTES=true

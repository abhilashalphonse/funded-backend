# ACG Funded backend — local development
NODE_ENV=development
PORT=3000

# Local databases
MONGODB_URI=mongodb://127.0.0.1:27017/acg_funded?replicaSet=rs0
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/acg_funded

# ACG Funded frontend
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY

# Use the real ACG Trader integration locally.
TRADING_PROVIDER=acg-trader
ACG_TRADER_BASE_URL=http://localhost:4000
ACG_TRADER_FRONTEND_URL=http://localhost:5174
ACG_TRADER_CLIENT_ID=acg-funded-local
ACG_TRADER_API_KEY=REPLACE_WITH_LOCAL_SERVICE_API_KEY
ACG_TRADER_TIMEOUT_MS=10000

# Must match ACG Trader backend ACG_FUNDED_WEBHOOK_SECRET.
ACG_TRADER_WEBHOOK_SECRET=local-acg-funded-webhook-secret-32chars

# NOWPayments is optional for non-payment local work.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_URL=http://localhost:3000/api/payments/crypto/ipn

ENABLE_SIMULATOR_ROUTES=true
ENABLE_LOCAL_ADMIN_ROUTES=true
